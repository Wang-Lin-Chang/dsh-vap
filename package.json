{
  "name": "dsh-vap",
  "version": "0.2.1",
  "description": "VAP — 可验证智能体交互协议（零第三方依赖）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "files": [
    "README.zh-CN.md",
    "CHANGELOG.md",
    "vap-spec.md",
    "vap-core.mjs",
    "vap-transport.mjs",
    "key-store.mjs",
    "logger.mjs",
    "config.mjs",
    "console-adapter.mjs",
    "laws.json",
    "bin/",
    "bridges/",
    "phase0/",
    "phase0.5/",
    "phase1/",
    "phase2/",
    "phase3/",
    "phase4/",
    "phase5/",
    "phase6/",
    "phase7/",
    "tests/",
    "!**/_*",
    "!**/experiments/**",
    "!**/trails*/",
    "!graynet-results/**",
    "!keys/**",
    "!**/*.pem"
  ],
  "bin": {
    "vap-relay": "bin/vap-relay.mjs",
    "vap-gateway": "bin/vap-gateway.mjs",
    "vap-node": "bin/vap-node.mjs",
    "vap-send": "bin/vap-send.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wang-Lin-Chang/dsh-vap.git"
  },
  "author": "Linchang Wang",
  "keywords": [
    "verifiable",
    "agent",
    "protocol",
    "p2p",
    "consensus",
    "ed25519",
    "nat-traversal",
    "stun",
    "relay",
    "zero-dependency"
  ],
  "scripts": {
    "test": "node --test",
    "relay": "node bin/vap-relay.mjs",
    "gateway": "node bin/vap-gateway.mjs",
    "node": "node bin/vap-node.mjs",
    "send": "node bin/vap-send.mjs"
  },
  "license": "Apache-2.0"
}
